tolerance = 1e-12
parity = -1
eig_tol = 0.05
norm_tol = 1e-12
proj_tol = 1e-10
Q0norm = 1
sort_orbit_flag = 0

scatter1_00 = 4.04
scatter1_10 = -43.2
scatter2_00 = 4.12

print_every_percent = 10
debug = n
